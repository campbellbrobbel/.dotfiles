#!/usr/bin/env bash

selection=$(tmux list-windows -F '#{window_id} #{window_name}' |
    fzf --header 'Select window' --prompt 'Window name: ' --exit-0 --reverse --with-nth=2..) || exit 0
[[ -n $selection ]] || exit 0
# Use the unique window ID so duplicate names are unambiguous.
tmux select-window -t "${selection%% *}"
