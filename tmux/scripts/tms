#!/usr/bin/env bash
set -e

if (( $# > 1 )); then
    printf 'Usage: tms [directory]\n' >&2
    exit 2
fi
if (( $# == 1 )); then
    selected=$1
else
    roots=()
    for directory in "$HOME/PhpstormProjects" "$HOME/.config" "$HOME/scripts"; do
        [[ ! -d $directory ]] || roots+=("$directory")
    done
    (( ${#roots[@]} )) || exit 0
    selected=$(find "${roots[@]}" -mindepth 1 -maxdepth 1 -type d | fzf) || exit 0
fi
[[ -n $selected ]] || exit 0
selected=$(cd -- "$selected" && pwd)
selected_name=$(basename "$selected" | tr '.:' '__')

if ! tmux has-session -t "=$selected_name" 2>/dev/null; then
    tmux new-session -ds "$selected_name" -c "$selected"
fi
if [[ -n $TMUX ]]; then
    tmux switch-client -t "=$selected_name"
else
    tmux attach-session -t "=$selected_name"
fi
