#!/usr/bin/env bash

CURRENT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
selection=$(tmux list-sessions -F '#{session_name}' |
    fzf --header 'Select session; type a new name to create one' \
        --prompt 'Session name: ' --exit-0 --print-query --reverse)
status=$?
case $status in
    0)
        [[ $selection == *$'\n'* ]] || exit 0
        session=${selection#*$'\n'}
        [[ -n $session ]] || exit 0
        tmux switch-client -t "=$session"
        ;;
    1)
        # fzf prints the query even when there is no matching session.
        [[ -n $selection ]] || exit 0
        "$CURRENT_DIR/make_new_session" "$selection"
        ;;
esac
